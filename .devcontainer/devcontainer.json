{
  "name": "${containerWorkspaceFolderBasename}",
  "image": "mcr.microsoft.com/devcontainers/base:debian12",
  "features": {
    "ghcr.io/bendwyer/devcontainer-features/claude-code:5": {},
    "ghcr.io/bendwyer/devcontainer-features/terraform:4": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "redhat.vscode-yaml"
      ]
    }
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.terraformrc",
      "target": "/home/vscode/.terraformrc,readonly",
      "type": "bind"
    }
  ]
}