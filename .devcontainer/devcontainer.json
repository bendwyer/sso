{
	"name": "sso",
	"image": "mcr.microsoft.com/devcontainers/base:debian12",
	"features": {
		"ghcr.io/bendwyer/devcontainer-features/terraform:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"github.vscode-github-actions",
				"GitHub.vscode-pull-request-github",
        "hashicorp.hcl",
				"hashicorp.terraform",
				"redhat.vscode-yaml"
			],
      "settings": {
        "dev.containers.copyGitConfig": true
      }
		}
	}
}